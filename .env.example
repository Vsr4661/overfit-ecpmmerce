# Copy to .env and fill in. Never commit .env.

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Signs session cookies and order-tracking links. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@overfit.local"
ADMIN_PASSWORD=""

# Public site URL (used in emails/links)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys locally)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Order emails via Resend (https://resend.com). Without these, emails are logged to the console.
RESEND_API_KEY=""
# Must be a sender on a domain verified in Resend, e.g. "Overfit <orders@yourdomain.in>"
EMAIL_FROM=""

# WhatsApp support button (digits with country code, e.g. 919876543210). Leave empty to hide.
WHATSAPP_NUMBER=""

# Printrove — token from Printrove dashboard > API
PRINTROVE_TOKEN=""
# Selling price = Printrove cost x markup, rounded up to the next ...99 (applied to newly synced products only)
PRINTROVE_MARKUP="1.8"
# Set to "true" to auto-submit paid orders to Printrove for fulfilment
PRINTROVE_AUTO_FULFIL="false"
# Secret for Printrove → Settings → Webhooks (point it at /api/webhooks/printrove)
PRINTROVE_WEBHOOK_SECRET=""
