# Copy to .env and fill in. Never commit .env.

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Signs session cookies and order-tracking links. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@overfit.local"
ADMIN_PASSWORD=""

# Public site URL (used in emails/links)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys locally)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Printrove — token from Printrove dashboard > API
PRINTROVE_TOKEN=""
# Selling price = Printrove cost x markup, rounded up to the next ...99 (applied to newly synced products only)
PRINTROVE_MARKUP="1.8"
# Set to "true" to auto-submit paid orders to Printrove for fulfilment
PRINTROVE_AUTO_FULFIL="false"
