generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection used by the app (on Vercel + Neon this is set automatically).
  url       = env("DATABASE_URL")
  /// Direct connection used for migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  /// Null for customers, who sign in with an emailed code instead of a password.
  passwordHash String?
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String
  /// Selling price in INR, set by the store (admin-editable).
  price        Float
  /// Fulfilment cost in INR (Printrove base price incl. GST). Null for non-Printrove products.
  costPrice    Float?
  imageUrl     String
  imageBackUrl String?
  /// Comma-separated sizes offered, e.g. "S,M,L,XL". Empty = one size.
  sizes        String      @default("")
  color        String?
  inventory    Int         @default(0)
  isActive     Boolean     @default(true)
  /// Printrove library product id; set for products synced from Printrove.
  printroveId  String?     @unique
  /// JSON array of Printrove library variants: [{ "id": 123, "size": "M", "sku": "..." }]
  printroveVariants String?
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// PENDING | PAID | PACKED | SHIPPED | DELIVERED | CANCELLED
  status            String      @default("PENDING")
  subtotal          Float
  discountCode      String?
  discountAmount    Float       @default(0)
  shippingFee       Float
  total             Float
  customerName      String
  customerEmail     String
  customerPhone     String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  country           String      @default("India")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  printroveOrderId  String?
  fulfilmentError   String?
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Snapshot of product name/price/image at purchase time.
  productName String
  imageUrl    String
  unitPrice   Float
  quantity    Int
  size        String?
  color       String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model DiscountCode {
  id          String    @id @default(cuid())
  /// Stored uppercase; matched case-insensitively by uppercasing input.
  code        String    @unique
  /// PERCENT | FIXED
  type        String
  /// Percent (1-90) for PERCENT, rupees for FIXED.
  value       Float
  minSubtotal Float     @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Webhook deliveries already handled (providers retry; dedupe on their event id).
model WebhookEvent {
  id        String   @id
  source    String
  createdAt DateTime @default(now())
}

/// One-time sign-in codes emailed to customers. Only a hash of the code is stored.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
